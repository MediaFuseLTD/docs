{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MediaFuse API",
  "colors": {
    "primary": "#0D9373",
    "light": "#20c997",
    "dark": "#096e56"
  },
  "favicon": "/favicon.svg",
  "api": {
    "openapi": "api-reference/openapi.json",
    "mdx": {
      "server": [
        "https://app.chainwire.org/api/external-api/v1",
        "https://app.financewire.com/api/external-api/v1",
        "https://app.cybernewswire.com/api/external-api/v1",
        "https://app.gamingwire.io/api/external-api/v1",
        "https://app.technologywire.com/api/external-api/v1",
        "https://app.playnewswire.com/api/external-api/v1",
        "https://clients.newsdirect.com/api/external-api/v1"
      ],
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "brands",
              "postman"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Authentication",
            "pages": [
              "api-reference/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/orders",
              "api-reference/articles"
            ]
          }
        ]
      },
      {
        "tab": "Publisher integration",
        "groups": [
          {
            "group": "WordPress",
            "pages": [
              "publishers/wordpress-plugin"
            ]
          },
          {
            "group": "Custom integration",
            "pages": [
              "publishers/overview",
              "publishers/receiving",
              "publishers/verifying",
              "publishers/troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/mediafuse/Logo_MediaFuse.svg",
    "dark": "/logo/mediafuse/Logo_MediaFuse_Negative.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@chainwire.org"
      }
    ]
  },
  "footer": {
